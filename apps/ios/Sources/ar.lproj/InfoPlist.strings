/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "يستخدم OpenAgent تقاويمك لعرض الأحداث وسياق الجدولة عند تمكين الوصول إلى التقويم.";
/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "يستخدم OpenAgent تقاويمك لعرض الأحداث وسياق الجدولة عند تمكين الوصول إلى التقويم.";
/* OpenAgent source: "OpenAgent uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "يستخدم OpenAgent تقاويمك لإضافة أحداث عند تمكين الوصول إلى التقويم.";
/* OpenAgent source: "OpenAgent uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "يستخدم OpenAgent الكاميرا عندما تمسح رمز QR لإعداد Gateway أو تطلب من Gateway المقترن أو مساعدك التقاط صورة أو مقطع فيديو قصير من جهاز iPhone هذا، على سبيل المثال للاتصال بـ Gateway أو لعرض مستند أو شاشة جهاز أو مساحة عمل على مساعدك.";
/* OpenAgent source: "OpenAgent uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "يستخدم OpenAgent جهات اتصالك لتتمكن من البحث عن الأشخاص والإشارة إليهم أثناء استخدام المساعد.";
/* OpenAgent source: "OpenAgent reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "يقرأ OpenAgent خطواتك ونومك ومعدل نبض قلبك أثناء الراحة وتمارينك من تطبيق Apple Health لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى مزود الذكاء الاصطناعي الذي أعددته.";
/* OpenAgent source: "OpenAgent does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "لا يكتب OpenAgent أي بيانات إلى تطبيق Apple Health. بل يستخدم البيانات بصلاحية القراءة فقط لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى موفّر الذكاء الاصطناعي الذي أعددته.";
/* OpenAgent source: "OpenAgent discovers and connects to your OpenAgent gateway on the local network." */
"NSLocalNetworkUsageDescription" = "يكتشف OpenAgent بوابة OpenAgent على الشبكة المحلية ويتصل بها.";
/* OpenAgent source: "OpenAgent can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "يمكن لـ OpenAgent مشاركة موقعك في الخلفية عند تمكين «دائمًا».";
/* OpenAgent source: "OpenAgent uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "يستخدم OpenAgent موقعك عندما تسمح بمشاركة الموقع.";
/* OpenAgent source: "OpenAgent uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "يستخدم OpenAgent الميكروفون للدردشة في الوقت الفعلي، والتنشيط الصوتي، والضغط للتحدث، والملاحظات الصوتية.";
/* OpenAgent source: "OpenAgent may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "قد يستخدم OpenAgent بيانات الحركة لدعم التفاعلات وعمليات الأتمتة التي تراعي الجهاز.";
/* OpenAgent source: "OpenAgent lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "يتيح OpenAgent لمساعدك قراءة الصور التي تسمح بها، ويتيح لك اختيار الصور لمشاركتها.";
/* OpenAgent source: "OpenAgent uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "يستخدم OpenAgent تذكيراتك لعرض المهام وإضافتها وإكمالها عند تمكين الوصول إلى التذكيرات.";
/* OpenAgent source: "OpenAgent uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "يستخدم OpenAgent ميزة التعرّف على الكلام على الجهاز لوضع التحدث والتنشيط الصوتي.";

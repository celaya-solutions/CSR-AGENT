/* OpenAgent source: "OpenAgent uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "OpenAgent використовує мікрофон для спілкування в реальному часі, голосової активації, розмови з натисканням кнопки та голосових нотаток.";
/* OpenAgent source: "OpenAgent may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "OpenAgent може використовувати дані про рух для взаємодій та автоматизацій з урахуванням стану пристрою.";

/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "وقتی دسترسی به تقویم را فعال می‌کنید، OpenAgent از تقویم‌های شما برای نمایش رویدادها و اطلاعات مرتبط با زمان‌بندی استفاده می‌کند.";
/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "وقتی دسترسی به تقویم را فعال می‌کنید، OpenAgent از تقویم‌های شما برای نمایش رویدادها و اطلاعات مرتبط با زمان‌بندی استفاده می‌کند.";
/* OpenAgent source: "OpenAgent uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "وقتی دسترسی به تقویم را فعال می‌کنید، OpenAgent از تقویم‌های شما برای افزودن رویدادها استفاده می‌کند.";
/* OpenAgent source: "OpenAgent uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "OpenAgent زمانی از دوربین استفاده می‌کند که کد QR راه‌اندازی Gateway را اسکن می‌کنید یا از Gateway جفت‌شده یا دستیار خود می‌خواهید با این iPhone عکس یا ویدیوی کوتاهی بگیرد، برای مثال برای اتصال به Gateway خود یا نشان دادن یک سند، صفحه‌نمایش دستگاه یا فضای کاری به دستیار.";
/* OpenAgent source: "OpenAgent uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "OpenAgent از مخاطبان شما استفاده می‌کند تا هنگام استفاده از دستیار بتوانید افراد را جستجو کنید و به آن‌ها ارجاع دهید.";
/* OpenAgent source: "OpenAgent reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "OpenAgent اطلاعات گام‌ها، خواب، ضربان قلب در حالت استراحت و تمرین‌های ورزشی شما را از برنامه Apple Health می‌خواند تا خلاصه‌های درخواستی شما را ایجاد کند و آن‌ها را از طریق Gateway شما به ارائه‌دهنده هوش مصنوعی پیکربندی‌شده ارسال کند.";
/* OpenAgent source: "OpenAgent does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "OpenAgent هیچ داده‌ای در برنامهٔ Apple Health نمی‌نویسد. از داده‌های فقط‌خواندنی برای ایجاد خلاصه‌های درخواستی شما استفاده می‌کند و آن‌ها را از طریق Gateway شما به ارائه‌دهندهٔ هوش مصنوعی پیکربندی‌شدهٔ شما می‌فرستد.";
/* OpenAgent source: "OpenAgent discovers and connects to your OpenAgent gateway on the local network." */
"NSLocalNetworkUsageDescription" = "OpenAgent دروازه OpenAgent شما را در شبکه محلی پیدا کرده و به آن متصل می‌شود.";
/* OpenAgent source: "OpenAgent can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "وقتی گزینهٔ همیشه را فعال کنید، OpenAgent می‌تواند موقعیت مکانی شما را در پس‌زمینه به اشتراک بگذارد.";
/* OpenAgent source: "OpenAgent uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "OpenAgent زمانی از موقعیت مکانی شما استفاده می‌کند که اجازهٔ اشتراک‌گذاری آن را بدهید.";
/* OpenAgent source: "OpenAgent uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "OpenAgent برای گفتگوی بی‌درنگ، فعال‌سازی با صدا، فشردن برای صحبت و یادداشت‌های صوتی از میکروفون استفاده می‌کند.";
/* OpenAgent source: "OpenAgent may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "OpenAgent ممکن است از داده‌های حرکتی برای پشتیبانی از تعامل‌ها و خودکارسازی‌های متناسب با وضعیت دستگاه استفاده کند.";
/* OpenAgent source: "OpenAgent lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "OpenAgent به دستیار شما اجازه می‌دهد عکس‌هایی را که مجاز کرده‌اید بخواند و به شما امکان می‌دهد عکس‌هایی را برای اشتراک‌گذاری انتخاب کنید.";
/* OpenAgent source: "OpenAgent uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "OpenAgent زمانی که دسترسی به یادآورها را فعال کنید، از آن‌ها برای فهرست کردن، افزودن و تکمیل کارها استفاده می‌کند.";
/* OpenAgent source: "OpenAgent uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "OpenAgent برای حالت مکالمه و فعال‌سازی با صدا از تشخیص گفتار روی دستگاه استفاده می‌کند.";

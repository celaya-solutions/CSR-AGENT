/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "OpenAgent, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* OpenAgent source: "OpenAgent uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "OpenAgent, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* OpenAgent source: "OpenAgent uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "OpenAgent, takvim erişimini etkinleştirdiğinizde etkinlik eklemek için takvimlerinizi kullanır.";
/* OpenAgent source: "OpenAgent uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "OpenAgent; bir Gateway kurulum QR kodunu taradığınızda veya eşleştirilmiş Gateway'inizden ya da asistanınızdan bu iPhone ile fotoğraf veya kısa video çekmesini istediğinizde kamerayı kullanır. Örneğin, Gateway'inize bağlanmak veya asistanınıza bir belgeyi, aygıt ekranını ya da çalışma alanını göstermek için.";
/* OpenAgent source: "OpenAgent uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "OpenAgent, asistanı kullanırken kişileri arayabilmeniz ve onlardan bahsedebilmeniz için kişilerinizi kullanır.";
/* OpenAgent source: "OpenAgent reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "OpenAgent; istediğiniz özetleri oluşturmak ve bunları Gateway aracılığıyla yapılandırılmış yapay zekâ sağlayıcınıza göndermek için Apple Health uygulamasındaki adım, uyku, dinlenme kalp atış hızı ve antrenman verilerinizi okur.";
/* OpenAgent source: "OpenAgent does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "OpenAgent, Apple Sağlık uygulamasına veri yazmaz. İstediğiniz özetleri oluşturmak ve bunları Gateway üzerinden yapılandırılmış yapay zekâ sağlayıcınıza göndermek için salt okunur verileri kullanır.";
/* OpenAgent source: "OpenAgent discovers and connects to your OpenAgent gateway on the local network." */
"NSLocalNetworkUsageDescription" = "OpenAgent, yerel ağdaki OpenAgent gateway'inizi bulur ve ona bağlanır.";
/* OpenAgent source: "OpenAgent can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Her Zaman seçeneğini etkinleştirdiğinizde OpenAgent, konumunuzu arka planda paylaşabilir.";
/* OpenAgent source: "OpenAgent uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "OpenAgent, konum paylaşımına izin verdiğinizde konumunuzu kullanır.";
/* OpenAgent source: "OpenAgent uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "OpenAgent; gerçek zamanlı sohbet, sesle uyandırma, bas-konuş ve sesli notlar için mikrofonu kullanır.";
/* OpenAgent source: "OpenAgent may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "OpenAgent, aygıta duyarlı etkileşimleri ve otomasyonları desteklemek için hareket verilerini kullanabilir.";
/* OpenAgent source: "OpenAgent lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "OpenAgent, izin verdiğiniz fotoğrafları asistanınızın okumasına ve paylaşılacak fotoğrafları seçmenize olanak tanır.";
/* OpenAgent source: "OpenAgent uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "OpenAgent, anımsatıcı erişimini etkinleştirdiğinizde görevleri listelemek, eklemek ve tamamlamak için anımsatıcılarınızı kullanır.";
/* OpenAgent source: "OpenAgent uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "OpenAgent, konuşma modu ve sesle uyandırma için aygıt üzerindeki konuşma tanıma özelliğini kullanır.";

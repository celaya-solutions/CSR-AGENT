# large vendor trees not needed for CLI build
vendor/

# Needed for building the Canvas A2UI bundle during Docker image builds.
# Keep the rest of vendor/ excluded to avoid a large build context.
!ui/src/lib/chat/tool-display.json
!vendor/a2ui/
!vendor/a2ui/renderers/
!vendor/a2ui/renderers/lit/
!vendor/a2ui/renderers/lit/**

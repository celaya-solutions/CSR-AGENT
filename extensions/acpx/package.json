{
  "name": "@openclaw/acpx",
  "version": "2026.9.4",
  "description": "OpenAgent ACP runtime backend with plugin-owned session and transport management.",
  "repository": {
    "type": "git",
    "url": "https://github.com/celaya-solutions/CSR-AGENT"
  },
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.75.1",
    "@agentclientprotocol/codex-acp": "1.10.0",
    "acpx": "0.13.2",
    "smol-toml": "1.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "staticAssets": [
        {
          "source": "./src/runtime-internals/mcp-proxy.mjs",
          "output": "mcp-proxy.mjs"
        },
        {
          "source": "./src/runtime-internals/mcp-command-line.mjs",
          "output": "mcp-command-line.mjs"
        }
      ]
    }
  }
}

                "cli": {
                  "flags": "--password <password>",
                  "description": "Matrix password"
                }
              },
              {
                "key": "deviceName",
                "kind": "string",
                "cli": {
                  "flags": "--device-name <name>",
                  "description": "Matrix device name"
                }
              },
              {
                "key": "avatarUrl",
                "kind": "string",
                "cli": {
                  "flags": "--avatar-url <url>",
                  "description": "Matrix avatar URL"
